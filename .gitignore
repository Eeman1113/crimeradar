# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.next-types/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# ingest cache (not yet built but planned)
/data/raw/
/data/snapshots/

# typescript
*.tsbuildinfo
next-env.d.ts

# local AI assistant instructions — keep on disk, never publish
CLAUDE.md
.claude/
.env.local

# stray agent artifacts (e.g. wizard reports left behind)
posthog-setup-report.md
*-setup-report.md
